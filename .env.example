# Generate with: openssl rand -hex 32
LUPA_API_TOKEN=

# Host bindings and ports. Keep loopback unless a trusted reverse proxy is used.
LUPA_API_BIND=127.0.0.1
LUPA_API_PORT=3036
SELKIES_BIND=127.0.0.1
SELKIES_PORT=6080

# Optional Selkies login. Set a strong password before exposing its port.
SELKIES_USER=lupa
SELKIES_PASSWORD=
LUPA_MAX_BODY_BYTES=5242880
